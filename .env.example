# Storage provider: 'supabase' | 's3' | 'gcs' (default: s3)
STORAGE_PROVIDER=supabase

# Supabase (when STORAGE_PROVIDER=supabase)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=meet-captures

# AWS S3 (when STORAGE_PROVIDER=s3)
S3_BUCKET=teencare-meet-captures
AWS_REGION=ap-southeast-1

# Google Cloud Storage (when STORAGE_PROVIDER=gcs)
GCS_BUCKET=meet-captures
GCS_KEY_FILE=/home/projects/meet-capture-api/gcs-key.json

# Server
HOST=0.0.0.0
PORT=8787
