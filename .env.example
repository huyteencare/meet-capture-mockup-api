# Storage provider: 'supabase' | 's3' (default: s3)
STORAGE_PROVIDER=supabase

# Supabase (when STORAGE_PROVIDER=supabase)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=meet-captures

# AWS S3 (when STORAGE_PROVIDER=s3)
S3_BUCKET=teencare-meet-captures
AWS_REGION=ap-southeast-1

# Server
HOST=0.0.0.0
PORT=8787
