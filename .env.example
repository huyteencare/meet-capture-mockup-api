# Storage provider: 'gcs' | 'supabase' (default: gcs)
STORAGE_PROVIDER=gcs

# Google Cloud Storage (when STORAGE_PROVIDER=gcs)
GCS_BUCKET=meet-captures
GCS_KEY_FILE=/home/projects/meet-capture-api/gcs-key.json
GCS_HMAC_ACCESS_KEY=GOOGA...  # optional — HMAC signing (~100x faster than RSA, no CPU spike)
GCS_HMAC_SECRET=...            # required if GCS_HMAC_ACCESS_KEY is set

# Supabase (when STORAGE_PROVIDER=supabase)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=meet-captures

# Server
HOST=0.0.0.0
PORT=8787
